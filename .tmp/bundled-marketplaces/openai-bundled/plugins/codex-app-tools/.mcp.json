{
  "mcpServers": {
    "codex_app": {
      "args": [
        "/d",
        "/s",
        "/c",
        "call",
        "./scripts/launch_codex_app_tools_mcp.cmd",
        "./server.mjs"
      ],
      "command": "cmd.exe",
      "cwd": ".",
      "enabled": false,
      "env_vars": [
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH",
        "XDG_CACHE_HOME",
        "HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "PATH"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 3600
    }
  }
}
